{
  "components": {
    "parameters": {
      "id": {
        "description": "The id the provider gave the resource, as returned on create.",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "namespace": {
        "in": "path",
        "name": "namespace",
        "required": true,
        "schema": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "type": "string"
        }
      }
    },
    "responses": {
      "Problem": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "An error, as RFC 9457 problem details"
      }
    },
    "schemas": {
      "Domain": {
        "properties": {
          "__meta__": {
            "description": "@SUMMARY Foreman representation of domain. Domains serve as an identification string that defines autonomy, authority, or control for a portion of a network.",
            "type": "boolean"
          },
          "fullname": {
            "description": "Description of the domain",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "description": "The name of the domain - the full DNS domain name. @EXAMPLE \"dev.dc1.company.com\"",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "A map of parameters that will be saved as domain parameters in the domain config.",
            "type": "object"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "DomainSpec": {
        "additionalProperties": false,
        "properties": {
          "fullname": {
            "description": "Description of the domain Defaults to `spec.name`.",
            "maxLength": 255,
            "type": "string",
            "x-default": "spec.name"
          },
          "name": {
            "description": "The DNS domain, such as acme.example.com.",
            "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "A map of parameters that will be saved as domain parameters in the domain config.",
            "type": "object"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "Host": {
        "properties": {
          "__meta__": {
            "description": "@SUMMARY A host managed by Foreman.",
            "type": "boolean"
          },
          "architecture_id": {
            "description": "ID of the architecture of this host",
            "type": "number"
          },
          "comment": {
            "description": "Add additional information about this host.Note: Changes to this attribute will trigger a host rebuild.",
            "type": "string"
          },
          "compute_attributes": {
            "description": "Hypervisor specific VM options. Must be a JSON string, as every compute provider has different attributes schema",
            "type": "string"
          },
          "compute_profile_id": {
            "type": "number"
          },
          "compute_resource_id": {
            "type": "number"
          },
          "config_group_ids": {
            "description": "IDs of the applied config groups.",
            "items": {
              "type": "number"
            },
            "type": "array",
            "uniqueItems": true
          },
          "domain_id": {
            "description": "ID of the domain to assign to the host.",
            "type": "number"
          },
          "domain_name": {
            "description": "The domain name of the host.",
            "type": "string"
          },
          "environment_id": {
            "description": "ID of the environment to assign to the host.",
            "type": "number"
          },
          "fqdn": {
            "description": "Host fully qualified domain name. Read-only value to be used in variables. @EXAMPLE \"compute01.dc1.company.com\"",
            "type": "string"
          },
          "hostgroup_id": {
            "description": "ID of the hostgroup to assign to the host.",
            "type": "number"
          },
          "id": {
            "type": "string"
          },
          "image_id": {
            "description": "ID of an image to be used as base for this host when cloning",
            "type": "number"
          },
          "interfaces_attributes": {
            "items": {
              "properties": {
                "attached_devices": {
                  "description": "Identifiers of attached interfaces, e.g. 'eth1', 'eth2' as comma-separated list",
                  "type": "string"
                },
                "attached_to": {
                  "description": "Identifier of the interface to which this interface belongs.",
                  "type": "string"
                },
                "bmc_provider": {
                  "description": "Provider used for BMC/IMPI functionality. Values include: `\"IPMI\"`",
                  "type": "string"
                },
                "compute_attributes": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Hypervisor specific interface options",
                  "type": "object"
                },
                "id": {
                  "description": "Unique identifier for the interface.",
                  "type": "number"
                },
                "identifier": {
                  "description": "Identifier of this interface local to the host.",
                  "type": "string"
                },
                "ip": {
                  "description": "IP address associated with the interface.",
                  "type": "string"
                },
                "mac": {
                  "description": "MAC address associated with the interface.",
                  "type": "string"
                },
                "managed": {
                  "description": "Whether or not this interface is managed by Foreman.",
                  "type": "boolean"
                },
                "name": {
                  "description": "Name of the interface",
                  "type": "string"
                },
                "primary": {
                  "description": "Whether or not this is the primary interface.",
                  "type": "boolean"
                },
                "provision": {
                  "description": "Whether or not this interface is used to provision the host.",
                  "type": "boolean"
                },
                "subnet_id": {
                  "description": "ID of the subnet to associate with this interface.",
                  "type": "number"
                },
                "type": {
                  "description": "The type of interface. Values include: `\"interface\"`, `\"bmc\"`, `\"bond\"`, `\"bridge\"`.",
                  "type": "string"
                },
                "username": {
                  "description": "Username used for BMC/IPMI functionality.",
                  "type": "string"
                },
                "virtual": {
                  "description": "Whether or not this is a virtual interface.",
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "manage_power_operations": {
            "description": "Manage power operations, e.g. power on, if host's build flag will be enabled.",
            "type": "boolean"
          },
          "managed": {
            "description": "Whether or not this host is managed by Foreman. Create host only, don't set build status or manage power states.",
            "type": "boolean"
          },
          "medium_id": {
            "description": "ID of the medium mounted on the host.",
            "type": "number"
          },
          "model_id": {
            "description": "ID of the hardware model if applicable",
            "type": "number"
          },
          "name": {
            "description": "Name of this host as stored in Foreman. Can be short name or FQDN, depending on your Foreman settings (especially the setting 'append_domain_name_for_hosts').",
            "type": "string"
          },
          "operatingsystem_id": {
            "description": "ID of the operating system to put on the host.",
            "type": "number"
          },
          "owner_id": {
            "description": "ID of the user or usergroup that owns the host.",
            "type": "number"
          },
          "owner_type": {
            "description": "Owner of the host, must be either User ot Usergroup",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "A map of parameters that will be saved as host parameters in the machine config.",
            "type": "object"
          },
          "provision_method": {
            "description": "Sets the provision method in Foreman for this host: either network-based ('build') or image-based ('image')",
            "type": "string"
          },
          "ptable_id": {
            "description": "ID of the partition table the host should use",
            "type": "number"
          },
          "puppet_class_ids": {
            "description": "IDs of the applied puppet classes.",
            "items": {
              "type": "number"
            },
            "type": "array",
            "uniqueItems": true
          },
          "subnet_id": {
            "description": "ID of the subnet the host should be placed in",
            "type": "number"
          },
          "token": {
            "description": "Build token. Can be used to signal to Foreman that a host build is complete.",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
