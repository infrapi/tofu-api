          },
          "ptable_id": {
            "description": "ID of the partition table associated with this hostgroup.",
            "type": "number"
          },
          "puppet_ca_proxy_id": {
            "description": "ID of the smart proxy acting as the puppet certificate authority server for this hostgroup.",
