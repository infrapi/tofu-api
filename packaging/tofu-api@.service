# One instance per provider: tofu-api@<provider> serves /etc/tofu-api/<provider>.yaml.
#   systemctl enable --now tofu-api@<provider>
[Unit]
Description=tofu-api for the %i provider
Documentation=file:///usr/share/doc/tofu-api/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tofu-api
Group=tofu-api
# The library's settings (INFRAPI_APP_*), its listen address among them: one
# port per instance.
Environment=INFRAPI_CONFIG_DOTENV_FILE=/etc/tofu-api/%i.env
# What ${VAR} in the provider's file reads, such as a provider's URL
# or VAULT_ROLE_ID: root-only, read by systemd.
EnvironmentFile=-/etc/tofu-api/%i.secrets
# Where a provider named by source is installed from and to: Terraform's CLI
# configuration, its plugin_cache_dir under the state directory, which
# systemd creates, keeps the service's, and leaves writable.
Environment=TF_CLI_CONFIG_FILE=/etc/tofu-api/terraformrc
StateDirectory=tofu-api
ExecStart=/usr/bin/tofu-api serve -config /etc/tofu-api/%i.yaml
Restart=on-failure
RestartSec=2s
# SIGTERM: the server gets 10s to finish its calls, then the providers stop.
TimeoutStopSec=30s

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
