# What ${VAR} in /etc/tofu-api/<provider>.yaml reads, at
# /etc/tofu-api/<provider>.secrets, mode 0600 root: systemd reads it.
# The names are the file's own, such as the provider's URL and credentials:
# PROVIDER_URL=https://...
# PROVIDER_AUTH=...
# Namespace mode (namespaces.vault in the provider's file); the secret id is a
# file the service reads at each login, such as
# /etc/tofu-api/<provider>.vault-secret-id, mode 0640 root:tofu-api.
# VAULT_ADDR=https://vault.example.com
# VAULT_ROLE_ID=...
