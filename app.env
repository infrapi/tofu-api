# The library's settings (INFRAPI_APP_*, validated by infrapi/lib/pkg/config)

INFRAPI_APP_NAME="tofu-api"
INFRAPI_APP_PLATFORM="sandbox"
INFRAPI_APP_REGION="eu-west-1"
INFRAPI_APP_LOCATION="dc1"
INFRAPI_APP_FQDN="tofu-api.localhost"
INFRAPI_APP_URL="http://localhost:8080"
INFRAPI_APP_LISTEN_ADDRESS="127.0.0.1:8080"
INFRAPI_APP_LOG_LEVEL="info"
INFRAPI_APP_LOG_FORMAT="json"
INFRAPI_APP_TRUSTED_PROXIES=[]
INFRAPI_APP_CORS_ALLOW_ORIGINS=["*"]

